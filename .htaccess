RewriteEngine On

# 1. Map clean project URLs to projects.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^projects/([^/]+)/([^/]+)$ projects.html?domain=$1&id=$2 [QSA,L]

# 2. Redirect direct requests for .html files to the clean URL
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html\s [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Redirect /index (or /index.html) to the root domain /
RewriteRule ^index$ / [R=301,L]

# 4. Internally serve .html files without requiring the extension in the browser
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]